<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//ActionContainer" position="before">
            <BoardFusionHomeMenu t-if="bfState.homeMenuActive" apps="menuService.getApps()"/>
        </xpath>
    </t>

        <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//Dropdown" position="replace">
            <a class="o_menu_toggle d-flex align-items-center cursor-pointer border-0 px-3 text-dark text-decoration-none"
               t-on-click.prevent="() => env.bus.trigger('BOARD_FUSION:TOGGLE_HOME_MENU')">
                
                <svg class="o_menu_toggle_icon pe-none" width="16px" height="16px" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
                    <g t-foreach="[0, 5, 10]" t-as="Y" fill="currentColor" t-att-id="'o_menu_toggle_row_' + Y_index" t-key="'o_menu_toggle_row_' + Y_index">
                        <rect t-foreach="[0, 5, 10]" t-as="X" width="3" height="3" t-att-x="X" t-att-y="Y" t-key="'o_menu_toggle_cell_' + X_index"/>
                    </g>
                </svg>

                <t t-if="currentApp">
                    <img t-if="currentApp.webIconData" 
                         t-att-src="currentApp.webIconData" 
                         class="o_menu_brand_icon d-none d-md-inline ms-3" 
                         style="width: 24px; height: 24px; border-radius: 4px;"
                         t-att-alt="currentApp.name"/>
                    <span t-esc="currentApp.name" class="o_menu_brand d-none d-md-flex ms-2 pe-0 fw-bold fs-5"/>
                </t>
            </a>
        </xpath>
    </t>
    
</templates>


